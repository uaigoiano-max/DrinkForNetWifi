#!/bin/sh /etc/rc.common
START=95
STOP=10

start() {
    mkdir -p /var/lib/drinkfornet
    logger -t drinkfornet "local voucher core ready; network adapter remains an explicit stub"
    /usr/sbin/drinkfornet-adapter reconcile >/dev/null 2>&1 || true
}

stop() {
    :
}

reload() {
    /usr/sbin/drinkfornet-adapter reconcile >/dev/null 2>&1 || true
}
